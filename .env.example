APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Production must set APP_ENV=production and APP_DEBUG=false to avoid leaking
# stack traces and internal paths to clients.
APP_DEBUG=true
# Public origin of the app. On the VPS this must be the HTTPS domain served by
# Caddy (e.g. https://app.example.com); the same value drives the Telegram
# webhook URL. Keep http://localhost:8000 for local development.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL from docker-compose.yml (service "db"). Laravel reads these from
# .env in every process, so they must be set here, not only in the compose file.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=rotless
DB_USERNAME=rotless
# Required, no default. Generate a strong one: openssl rand -hex 32
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
OPENFOODFACTS_TIMEOUT=10

TELEGRAM_BOT_TOKEN=
# Optional: bot username for the account-linking deep link (without the @).
# When empty it is resolved from the bot token via getMe.
TELEGRAM_BOT_USERNAME=
# Secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
# Recipient chat used only by the `app:telegram-smoke` end-to-end check.
TELEGRAM_CHAT_ID=
EXPIRY_WARNING_DAYS=3

VITE_APP_NAME="${APP_NAME}"
