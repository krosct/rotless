# rotless reverse proxy (production), behind Cloudflare.
#
# Serves the React SPA from /srv (frontend/dist) and proxies /api/* to the
# Laravel container. The site address is taken from APP_URL, so it stays in
# sync with the Telegram webhook URL.
#
# Cloudflare proxies the domain and connects to this origin with SSL mode
# "Full (strict)". HTTPS uses a Cloudflare Origin Certificate mounted from
# ./certs (origin.pem + origin.key, never committed).
#
# Cloudflare IP ranges (https://www.cloudflare.com/ips, checked 2026-09-27)
# appear twice below; keep both lists in sync when Cloudflare changes them.
#
# Started only with the "caddy" profile:
#   docker compose --profile caddy up -d

{
	servers {
		# Resolve the visitor's IP from CF-Connecting-IP, but only when the
		# connection really comes from Cloudflare.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$APP_URL} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	route {
		# Only Cloudflare may reach the origin: direct hits on the VPS IP would
		# bypass its DDoS/WAF protection, so drop them.
		@direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		abort @direct

		# API (including /api/v1/telegram/webhook) -> Laravel. Send the resolved
		# visitor IP as the only X-Forwarded-For value, so the rate limits see
		# the real client instead of a Cloudflare edge address.
		handle /api/* {
			reverse_proxy app:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		# SPA -> static files with client-side routing fallback
		handle {
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}

	# Long-lived cache for hashed build assets
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
