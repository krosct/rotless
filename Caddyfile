# rotless's web server in production: FrankenPHP (PHP with Caddy built in; devkit's INSTALL puts
# the static binary in /srv/rotless/tools) on 127.0.0.1, on the port devkit chose for rotless
# (ROTLESS_HTTP_PORT). It runs Laravel for /api/* and serves the React SPA (frontend/dist) for the
# rest. It is not the public entry point: the VPS's shared Caddy (devkit) terminates HTTPS with the
# Cloudflare Origin Certificate and forwards here with the visitor's IP in X-Forwarded-For, which
# Laravel trusts only from 127.0.0.1 (bootstrap/app.php).
#
# Started by the RUN command of deploy.conf, from the release folder:
#   frankenphp run --config Caddyfile --adapter caddyfile
{
	admin off
	auto_https off

	frankenphp {
		# Classic mode: one PHP request per thread, no long-lived workers. Each thread can use up
		# to memory_limit, so keep this small on a 1 GB VPS; raise it with FRANKENPHP_THREADS.
		num_threads {$FRANKENPHP_THREADS:4}

		# Product photos are validated up to 5 MB (StoreBatchRequest, UpdateProductRequest);
		# PHP's 2 MB default rejected larger files before Laravel could see them.
		php_ini upload_max_filesize 6M
		php_ini post_max_size 8M
		# Errors go to the log (journalctl), never into a response.
		php_ini display_errors Off
		php_ini log_errors On
		# Do not advertise the PHP version in an X-Powered-By header.
		php_ini expose_php Off
	}
}

# Any Host (the shared Caddy sends the public domain), only on 127.0.0.1.
http://:{$ROTLESS_HTTP_PORT:8000} {
	bind 127.0.0.1
	encode zstd gzip

	route {
		# API (including /api/v1/telegram/webhook) -> Laravel (public/index.php)
		handle /api/* {
			root * public
			php_server
		}

		# SPA -> static files with client-side routing fallback
		handle {
			root * frontend/dist
			try_files {path} /index.html
			file_server
		}
	}

	# Long-lived cache for hashed build assets
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# PWA entry points must always be revalidated, or an installed app (and
	# Cloudflare's edge) keeps an old service worker and never sees new deploys.
	@pwa path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache"

	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Do not advertise the server stack.
		-Server
	}
}
