# rotless internal web server (production): plain HTTP on 127.0.0.1, on the
# port devkit chose for rotless (ROTLESS_HTTP_PORT).
#
# Serves the React SPA from /srv (frontend/dist) and proxies /api/* to the
# Laravel container. It is not the public entry point: the VPS runs one shared
# Caddy for all its apps (the devkit layer: /etc/caddy/Caddyfile imports
# /srv/caddy/sites/*.caddy). That one terminates HTTPS with the Cloudflare
# Origin Certificate and forwards here with the visitor's IP (CF-Connecting-IP,
# trusted only from Cloudflare) in X-Forwarded-For. devkit writes rotless's
# site there (/srv/caddy/sites/rotless.caddy) on every deploy.
#
# Started only with the "caddy" profile:
#   docker compose --profile caddy up -d
{
	auto_https off

	servers {
		# The shared Caddy reaches this container through Docker's bridge, so
		# trust X-Forwarded-For from private addresses only.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	route {
		# API (including /api/v1/telegram/webhook) -> Laravel, with the
		# visitor IP as the only X-Forwarded-For value, so the rate limits see
		# the real client.
		handle /api/* {
			reverse_proxy app:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		# SPA -> static files with client-side routing fallback
		handle {
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}

	# Long-lived cache for hashed build assets
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# PWA entry points must always be revalidated, or an installed app (and
	# Cloudflare's edge) keeps an old service worker and never sees new deploys.
	@pwa path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache"

	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
